 printf %s 'cmjt_E_S' | docker secret create tierplan-agent-token-g1 - && docker service create --name tierplan-agent --mode global --constraint node.platform.os==linux --secret source=tierplan-agent-token-g1,target=tierplan-agent-token,mode=0400 --mount type=bind,src=/var/run/docker.sock,dst=/var/run/docker.sock --mount type=volume,src=tierplan-agent,dst=/var/lib/tierplan-agent --mount type=bind,src=/proc/1/net/route,dst=/host/route,ro --read-only --cap-drop ALL --cap-add SETUID --cap-add SETGID --update-parallelism 1 --update-delay 10s --label tierplan.agent=true --container-label tierplan.agent=true --env 'TIERPLAN_AGENT_URL=wss://example.com/tierplan/agent/connect' --env 'TIERPLAN_AGENT_PIN=sha256/P' --env 'TIERPLAN_AGENT_JOIN_TOKEN_FILE=/run/secrets/tierplan-agent-token' ghcr.io/ianglennon/tierplan-agent:0.2.0