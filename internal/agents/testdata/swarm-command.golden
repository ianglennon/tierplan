 printf %s 'bpjt_E_S' | docker secret create bayplan-agent-token-g1 - && docker service create --name bayplan-agent --mode global --constraint node.platform.os==linux --secret source=bayplan-agent-token-g1,target=bayplan-agent-token,mode=0400 --mount type=bind,src=/var/run/docker.sock,dst=/var/run/docker.sock --mount type=volume,src=bayplan-agent,dst=/var/lib/bayplan-agent --read-only --cap-drop ALL --cap-add SETUID --cap-add SETGID --update-parallelism 1 --update-delay 10s --label bayplan.agent=true --container-label bayplan.agent=true --env 'BAYPLAN_AGENT_URL=wss://example.com/bayplan/agent/connect' --env 'BAYPLAN_AGENT_PIN=sha256/P' --env 'BAYPLAN_AGENT_JOIN_TOKEN_FILE=/run/secrets/bayplan-agent-token' ghcr.io/ianglennon/bayplan-agent:0.2.0