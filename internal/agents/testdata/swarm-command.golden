 printf %s 'cmjt_E_S' | docker secret create coaming-agent-token-g1 - && docker service create --name coaming-agent --mode global --constraint node.platform.os==linux --secret source=coaming-agent-token-g1,target=coaming-agent-token,mode=0400 --mount type=bind,src=/var/run/docker.sock,dst=/var/run/docker.sock --mount type=volume,src=coaming-agent,dst=/var/lib/coaming-agent --read-only --cap-drop ALL --cap-add SETUID --cap-add SETGID --update-parallelism 1 --update-delay 10s --label coaming.agent=true --container-label coaming.agent=true --env 'COAMING_AGENT_URL=wss://example.com/coaming/agent/connect' --env 'COAMING_AGENT_PIN=sha256/P' --env 'COAMING_AGENT_JOIN_TOKEN_FILE=/run/secrets/coaming-agent-token' ghcr.io/ianglennon/coaming-agent:0.2.0