 docker run -d --name bayplan-agent --restart unless-stopped --read-only --cap-drop ALL --cap-add SETUID --cap-add SETGID --security-opt no-new-privileges -v /var/run/docker.sock:/var/run/docker.sock -v bayplan-agent:/var/lib/bayplan-agent --label bayplan.agent=true -e 'BAYPLAN_AGENT_URL=wss://example.com/bayplan/agent/connect' -e 'BAYPLAN_AGENT_PIN=sha256/P' -e 'BAYPLAN_AGENT_JOIN_TOKEN=bpjt_E_S' ghcr.io/ianglennon/bayplan-agent:0.2.0