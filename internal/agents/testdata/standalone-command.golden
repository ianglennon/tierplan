 docker run -d --name coaming-agent --restart unless-stopped --read-only --cap-drop ALL --cap-add SETUID --cap-add SETGID --security-opt no-new-privileges -v /var/run/docker.sock:/var/run/docker.sock -v coaming-agent:/var/lib/coaming-agent --label coaming.agent=true -e 'COAMING_AGENT_URL=wss://example.com/coaming/agent/connect' -e 'COAMING_AGENT_PIN=sha256/P' -e 'COAMING_AGENT_JOIN_TOKEN=bpjt_E_S' ghcr.io/ianglennon/coaming-agent:0.2.0