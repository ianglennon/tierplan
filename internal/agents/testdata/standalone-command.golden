 docker run -d --name tierplan-agent --restart unless-stopped --read-only --cap-drop ALL --cap-add SETUID --cap-add SETGID --security-opt no-new-privileges -v /var/run/docker.sock:/var/run/docker.sock -v tierplan-agent:/var/lib/tierplan-agent -v /proc/1/net/route:/host/route:ro --label tierplan.agent=true -e 'TIERPLAN_AGENT_URL=wss://example.com/tierplan/agent/connect' -e 'TIERPLAN_AGENT_PIN=sha256/P' -e 'TIERPLAN_AGENT_JOIN_TOKEN=tpjt_E_S' ghcr.io/ianglennon/tierplan-agent:0.2.0