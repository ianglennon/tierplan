 OLD=$(docker service inspect -f '{{(index .Spec.TaskTemplate.ContainerSpec.Secrets 0).SecretName}}' coaming-agent) && printf %s 'bpjt_E_S' | docker secret create coaming-agent-token-g2 - && docker service update --secret-rm "$OLD" --secret-add source=coaming-agent-token-g2,target=coaming-agent-token,mode=0400 coaming-agent && docker secret rm "$OLD"