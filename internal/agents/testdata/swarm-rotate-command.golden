 OLD=$(docker service inspect -f '{{(index .Spec.TaskTemplate.ContainerSpec.Secrets 0).SecretName}}' bayplan-agent) && printf %s 'bpjt_E_S' | docker secret create bayplan-agent-token-g2 - && docker service update --secret-rm "$OLD" --secret-add source=bayplan-agent-token-g2,target=bayplan-agent-token,mode=0400 bayplan-agent && docker secret rm "$OLD"