 OLD=$(docker service inspect -f '{{(index .Spec.TaskTemplate.ContainerSpec.Secrets 0).SecretName}}' tierplan-agent) && printf %s 'cmjt_E_S' | docker secret create tierplan-agent-token-g2 - && docker service update --secret-rm "$OLD" --secret-add source=tierplan-agent-token-g2,target=tierplan-agent-token,mode=0400 tierplan-agent && docker secret rm "$OLD"