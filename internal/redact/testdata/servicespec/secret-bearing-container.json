{
  "Id": "c0ffee",
  "Path": "/bin/api",
  "Args": ["--requirepass", "SECRET-ARGS-VALUE"],
  "State": {"Pid": 9007199254740993},
  "Config": {
    "Image": "registry.example.com/shop/api:1.4",
    "Env": ["DB_PASSWORD=SECRET-ENV-VALUE", "DSN=postgres://u:SECRET-DSN@db/app?x=1=2", "FLAG"],
    "Cmd": ["/bin/api", "--token", "SECRET-CMD-ARG"],
    "Entrypoint": ["/bin/api", "--token", "SECRET-CMD-ARG"],
    "Healthcheck": {
      "Test": ["CMD-SHELL", "curl -u admin:SECRET-HC-CMD http://localhost/health"],
      "Interval": 30000000000
    }
  },
  "HostConfig": {
    "LogConfig": {"Type": "splunk", "Config": {"splunk-token": "SECRET-LOG-OPT", "splunk-url": "https://splunk.example.com"}}
  }
}
