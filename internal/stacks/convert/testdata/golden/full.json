{
  "Networks": [
    {
      "Key": "default",
      "Name": "full_default",
      "Driver": "overlay",
      "Attachable": true,
      "Internal": false,
      "External": false,
      "Labels": {
        "bayplan.stack.id": "id-full",
        "com.docker.stack.namespace": "full"
      },
      "DriverOpts": null,
      "IPAMDriver": "",
