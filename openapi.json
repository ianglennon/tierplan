{
  "components": {
    "schemas": {
      "ChangePasswordBody": {
        "additionalProperties": false,
        "properties": {
          "csrfToken": {
            "description": "The CSRF token of the new session, sent as X-CSRF-Token on every mutating request",
            "type": "string"
          }
        },
        "required": [
          "csrfToken"
        ],
        "type": "object"
      },
      "ChangePasswordInputBody": {
        "additionalProperties": false,
        "properties": {
          "currentPassword": {
            "description": "The password the account has now",
            "maxLength": 1024,
            "type": "string"
          },
          "newPassword": {
            "description": "The new password; at least 12 characters, not a common password and not containing the username",
            "maxLength": 1024,
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object"
      },
      "CompleteSetupBody": {
        "additionalProperties": false,
        "properties": {
          "csrfToken": {
            "description": "Sent as X-CSRF-Token on every mutating request",
            "type": "string"
          },
          "instanceName": {
            "description": "The stored instance name",
            "type": "string"
          },
          "publicUrl": {
            "description": "The public URL in effect",
            "type": "string"
          },
          "publicUrlLocked": {
            "description": "True when BAYPLAN_PUBLIC_URL fixed the public URL and the submitted one was ignored",
            "type": "boolean"
          },
          "user": {
            "$ref": "#/components/schemas/SetupUserBody",
            "description": "The admin account that was created"
          }
        },
        "required": [
          "user",
          "csrfToken",
          "instanceName",
          "publicUrl",
          "publicUrlLocked"
        ],
        "type": "object"
      },
      "CompleteSetupInputBody": {
        "additionalProperties": false,
        "properties": {
          "instanceName": {
            "description": "Display name, 1 to 64 characters",
            "maxLength": 256,
            "type": "string"
          },
          "password": {
            "description": "At least 12 characters, not on the common-password list and not containing the username",
            "maxLength": 1024,
            "type": "string"
          },
          "publicUrl": {
            "description": "The address people use to reach Bayplan; ignored when BAYPLAN_PUBLIC_URL fixes it",
            "maxLength": 2048,
            "type": "string"
          },
          "token": {
            "description": "The setup token printed in the container log",
            "maxLength": 128,
            "type": "string"
          },
          "username": {
            "description": "3 to 32 characters from a-z, 0-9, dot, dash and underscore; stored lower-case",
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": [
          "token",
          "username",
          "password",
          "instanceName",
          "publicUrl"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "InstanceBody": {
        "additionalProperties": false,
        "properties": {
          "instanceName": {
            "description": "Display name of this instance, empty before setup",
            "type": "string"
          },
          "needsSetup": {
            "description": "True while no admin exists and the setup wizard is open",
            "type": "boolean"
          },
          "rememberDays": {
            "description": "Days a 'keep me signed in' session lasts",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "instanceName",
          "needsSetup",
          "rememberDays"
        ],
        "type": "object"
      },
      "LocalHostBody": {
        "additionalProperties": false,
        "properties": {
          "detected": {
            "description": "Whether a unix socket exists at that path",
            "type": "boolean"
          },
          "probe": {
            "$ref": "#/components/schemas/ProbeResult",
            "description": "What the engine behind the socket reported; absent when no socket exists"
          },
          "socketPath": {
            "description": "The Docker socket path Bayplan was configured with",
            "type": "string"
          }
        },
        "required": [
          "socketPath",
          "detected"
        ],
        "type": "object"
      },
      "LoginBody": {
        "additionalProperties": false,
        "properties": {
          "csrfToken": {
            "description": "Sent as X-CSRF-Token on every mutating request",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserBody",
            "description": "The signed-in user"
          }
        },
        "required": [
          "user",
          "csrfToken"
        ],
        "type": "object"
      },
      "LoginInputBody": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "description": "The account password",
            "maxLength": 1024,
            "type": "string"
          },
          "remember": {
            "description": "Keep this browser signed in for the remember lifetime instead of until it has been idle for the idle timeout",
            "type": "boolean"
          },
          "username": {
            "description": "The account name; matched case-insensitively",
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "MeBody": {
        "additionalProperties": false,
        "properties": {
          "csrfToken": {
            "description": "Sent as X-CSRF-Token on every mutating request",
            "type": "string"
          },
          "permissions": {
            "$ref": "#/components/schemas/PermissionsBody",
            "description": "Effective permissions of the signed-in user"
          },
          "user": {
            "$ref": "#/components/schemas/UserBody",
            "description": "The signed-in user"
          }
        },
        "required": [
          "user",
          "csrfToken",
          "permissions"
        ],
        "type": "object"
      },
      "PermissionsBody": {
        "additionalProperties": false,
        "properties": {
          "environments": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "description": "Permissions per environment ID; the key * holds those that apply to every environment",
            "type": "object"
          },
          "global": {
            "description": "Installation-wide permissions",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "global",
          "environments"
        ],
        "type": "object"
      },
      "ProbeResult": {
        "additionalProperties": false,
        "properties": {
          "apiVersion": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "engineName": {
            "type": "string"
          },
          "engineVersion": {
            "type": "string"
          },
          "hostname": {
            "type": "string"
          },
          "kernelVersion": {
            "type": "string"
          },
          "memTotal": {
            "format": "int64",
            "type": "integer"
          },
          "ncpu": {
            "format": "int64",
            "type": "integer"
          },
          "negotiatedApi": {
            "type": "string"
          },
          "os": {
            "type": "string"
          },
          "osType": {
            "type": "string"
          },
          "probedAt": {
            "format": "date-time",
            "type": "string"
          },
          "reachable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "storageDriver": {
            "type": "string"
          },
          "supported": {
            "type": "boolean"
          },
          "swarmNodeState": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "reachable",
          "supported",
          "probedAt"
        ],
        "type": "object"
      },
      "SetupDefaultsBody": {
        "additionalProperties": false,
        "properties": {
          "defaultInstanceName": {
            "description": "The server's hostname",
            "type": "string"
          },
          "publicUrl": {
            "description": "The configured public URL, empty when none is set",
            "type": "string"
          },
          "publicUrlLocked": {
            "description": "True when BAYPLAN_PUBLIC_URL fixes the public URL",
            "type": "boolean"
          }
        },
        "required": [
          "defaultInstanceName",
          "publicUrl",
          "publicUrlLocked"
        ],
        "type": "object"
      },
      "SetupUserBody": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The user's ID",
            "type": "string"
          },
          "role": {
            "description": "The user's global role",
            "type": "string"
          },
          "username": {
            "description": "The lower-cased username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role"
        ],
        "type": "object"
      },
      "UserBody": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The user's ID",
            "type": "string"
          },
          "role": {
            "description": "The user's global role, empty when they have none",
            "type": "string"
          },
          "username": {
            "description": "The lower-cased username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role"
        ],
        "type": "object"
      },
      "VerifySetupTokenInputBody": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "description": "The setup token printed in the container log",
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "VersionBody": {
        "additionalProperties": false,
        "properties": {
          "commit": {
            "description": "Full source commit, empty when unknown",
            "type": "string"
          },
          "display": {
            "description": "Human readable version, for example v0.1.0 (abc1234)",
            "type": "string"
          },
          "sourceTreeUrl": {
            "description": "URL of the exact source tree this build was made from",
            "type": "string"
          },
          "sourceUrl": {
            "description": "Root URL of the source code",
            "type": "string"
          },
          "version": {
            "description": "Release version, or dev for an untagged build",
            "type": "string"
          }
        },
        "required": [
          "version",
          "commit",
          "display",
          "sourceUrl",
          "sourceTreeUrl"
        ],
        "type": "object"
      },
      "WarningBody": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Which warning this is",
            "enum": [
              "data_not_persisted",
              "key_backup"
            ],
            "type": "string"
          },
          "keyPath": {
            "description": "For key_backup: where the generated encryption key is stored",
            "type": "string"
          },
          "reason": {
            "description": "For data_not_persisted: why the data directory is not persisted",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "WarningsBody": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "Only the warnings that apply; empty when there are none",
            "items": {
              "$ref": "#/components/schemas/WarningBody"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Bayplan API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "description": "Starts a server-side session and sets its cookie. Every failure, whether the user is unknown, the password is wrong, the account is locked or disabled or the address is rate limited, answers 401 invalid_credentials with the same body (D-30). A session the browser already holds is ended first.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Sign in with a username and password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "description": "Ends only the session this request was made with and clears its cookie. The user's other devices stay signed in (D-33).",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "No Content",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Sign out of this browser",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/instance": {
      "get": {
        "operationId": "getInstance",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get the instance name, whether setup is needed and the remember-me length",
        "tags": [
          "setup"
        ]
      }
    },
    "/api/local-host": {
      "get": {
        "description": "Reports whether a Docker socket exists at the configured path and, if so, what engine answers on it: supported or not (and why), its version and API version, and whether the host is a Swarm manager, a Swarm worker or standalone. Read-only. Needs environments.write because it is the context for adding the host.",
        "operationId": "getLocalHost",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalHostBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Detect the Docker engine on this server's own host",
        "tags": [
          "environments"
        ]
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get the signed-in user, their CSRF token and their effective permissions",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/me/password": {
      "post": {
        "description": "Needs the current password. On success every session of the user ends, this one included, and a new session starts: its cookie is set and its CSRF token returned (D-32, D-34). A wrong current password or a new password that breaks the policy answers 422 with a stable code per field. Audited as auth.password_changed.",
        "operationId": "changePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangePasswordBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Change the signed-in user's own password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/setup/complete": {
      "post": {
        "description": "Needs the setup token. Runs once: it creates the admin, assigns the global admin role, stores the instance name and public URL, starts a session and audits setup.completed in one transaction, then consumes the token. A second call answers 409 setup_complete.",
        "operationId": "completeSetup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteSetupInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompleteSetupBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Create the first admin, store the instance settings and sign in",
        "tags": [
          "setup"
        ]
      }
    },
    "/api/setup/token": {
      "post": {
        "operationId": "verifySetupToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifySetupTokenInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupDefaultsBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Check the setup token and return the step 3 defaults",
        "tags": [
          "setup"
        ]
      }
    },
    "/api/version": {
      "get": {
        "operationId": "getVersion",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get the running Bayplan version and source link",
        "tags": [
          "system"
        ]
      }
    },
    "/api/warnings": {
      "get": {
        "description": "Includes data_not_persisted while the data directory would be lost with the container, and key_backup while the encryption key Bayplan generated into the data directory has not been acknowledged (D-15, D-59). The plain-HTTP warning is the browser's to compute and is not listed.",
        "operationId": "listWarnings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WarningsBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List the instance warnings that need an admin's attention",
        "tags": [
          "settings"
        ]
      }
    },
    "/api/warnings/key-backup/ack": {
      "post": {
        "description": "Records, once for the whole instance, that the generated encryption key has been backed up, and audits it as warning.acknowledged.",
        "operationId": "acknowledgeKeyBackup",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Acknowledge the encryption key backup reminder",
        "tags": [
          "settings"
        ]
      }
    }
  }
}
