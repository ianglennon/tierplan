[
  {
    "name": "clean spec",
    "escalates": false,
    "spec": {
      "Name": "web",
      "TaskTemplate": {
        "ContainerSpec": {
          "Image": "nginx:1.27",
          "Mounts": [
            {"Type": "volume", "Source": "web-data", "Target": "/data"},
            {"Type": "tmpfs", "Target": "/tmp"}
          ]
        }
      }
    }
  },
  {
    "name": "bind of the docker socket",
    "escalates": true,
    "spec": {
      "Name": "web",
      "TaskTemplate": {
        "ContainerSpec": {
          "Image": "nginx:1.27",
          "Mounts": [{"Type": "bind", "Source": "/var/run/docker.sock", "Target": "/sock"}]
        }
      }
    }
  },
  {
