          ]
        },
        "RestartPolicy": {
          "Condition": "any",
          "Delay": 2000000000
        },
        "Networks": [
          {
            "Target": "host"
          }
        ],
        "LogDriver": {
          "Name": "json-file",
          "Options": {
            "max-file": "3",
            "max-size": "1m"
          }
        },
        "ForceUpdate": 0
      },
      "Mode": {
        "Global": {}
      },
      "UpdateConfig": {
        "Parallelism": 1,
        "Delay": 10000000000,
        "FailureAction": "rollback",
        "Monitor": 5000000000,
        "MaxFailureRatio": 0,
        "Order": "stop-first"
      },
      "RollbackConfig": {
        "Parallelism": 1,
        "Monitor": 5000000000,
        "MaxFailureRatio": 0,
